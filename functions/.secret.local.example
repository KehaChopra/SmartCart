# Copy to .secret.local for local Firebase emulator / deploy.
# .secret.local is gitignored and never pushed to GitHub.
#
# For production deploy, also run:
#   firebase functions:secrets:set CART_SECRET
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
CART_SECRET=your_cart_secret_here
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
