## Copy this file to local.properties and fill in your own values.
## local.properties is gitignored and never pushed to GitHub.

# Android SDK path (Android Studio usually sets this automatically)
sdk.dir=C\:\\Path\\To\\Android\\Sdk

# Shared secret for SmartKart Cloud Functions (must match Firebase CART_SECRET)
CART_SECRET=your_cart_secret_here

# bindCartToUser function URL (ends with /)
BIND_CART_BASE_URL=https://your-bind-cart-url/

# Cloud Functions base URL for deleteItemFromCart etc. (ends with /)
CLOUD_FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net/
